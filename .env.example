# Copy this file to .env.local and fill in the values you need.

# Anthropic API key for AI triage. If left empty the app still runs, and every
# request's triage is marked failed with "no API key configured".
ANTHROPIC_API_KEY=

# Optional. Model used for triage. Defaults to claude-haiku-5-5.
# ANTHROPIC_MODEL=claude-haiku-5-5

# Optional. If unset, an in-memory MongoDB starts automatically (data resets
# every time the dev server stops).
# MONGODB_URI=mongodb://localhost:27017
